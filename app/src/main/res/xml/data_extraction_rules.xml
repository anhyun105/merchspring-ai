<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Cloud backup is intentionally excluded until a deliberate encrypted
             backup/recovery product is implemented. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Permit a user-initiated device-to-device migration. This is not a cloud
             backup; test device-transfer behavior on supported Android versions. -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
